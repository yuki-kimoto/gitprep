<%
  use Gitprep::Repository;

  my $api = gitprep_api;
  my $markdown = '';

  if (lc $self->req->method eq 'post') {
    return if csrf_error;

    my $text = param('text');
    my $rep_info = Gitprep::Repository->new(param('user'), param('project'));

    $markdown = $api->markdown($text, $rep_info, rev => param('rev'));
  }

  $self->render(
    json => {
      markdown => $markdown
    }
  );
  return;
%>
