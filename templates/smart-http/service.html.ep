<%
  use Mojo::IOLoop;
  use Gitprep::Repository;
  use Gitprep::Fifo;
  use Gitprep::Jobs;

  my $service = param('service');
  my $user = param('user');
  my $project = param('project');

  my $git = app->git;
  my $jobs = app->jobs;

  my $auth_user_id = stash('auth_user_id') // '';

  my $rep_info = Gitprep::Repository->maybe_wiki($user, $project);

  my $outstream;                        # Standard git output stream.
  my $tx;                               # Current transaction.
  my $wcactive = 0;                     # Flag currently writing chunk.
  my $error = '';                       # Git error buffer.
  my $fifo = Gitprep::Fifo->new;        # Output fifo.

  # Chunk output pump.
  my $wcpump;
  $wcpump = sub {
    my $c = shift;
    $wcactive = 0;
    return if $fifo->empty;
    my $data = $fifo->pop;
    if ($data eq '') {
      $c->finish;
      $tx = undef;      # Release transaction.
      $wcpump = undef;  # Release output pump.
      $fifo = undef;    # Release fifo.
      return;
    }
    $c->write_chunk($data, $wcpump);
    $wcactive = 1;
  };

  # Setup fifo.
  $fifo->on(ready => sub {$self->$wcpump unless $wcactive});
  $fifo->on(low => sub {$outstream->start if $outstream});
  $fifo->on(high => sub {$outstream->stop});

  # Prepare response
  $self->res->headers->content_type("application/x-git-$service-result");
  $tx = $self->render_later->tx;        # Keep transaction alive.

  # Closeout function.
  my $terminate = sub {
    $fifo->push('');
    $self->app->log->error($self->url_for . ": $error") if $error ne '';
    ()
  };

  # Command
  my @cmd = $git->cmd(
    $rep_info,
    $service,
    '--stateless-rpc',
    $rep_info->git_dir
  );

  # Preset hooks and get child environment.
  my %environ = %ENV;
  app->manager->prepare_hooks($rep_info, $auth_user_id, \%environ);

  # Prepare job.
  my $pos = 0;
  my $content = $self->req->content;
  my $job = $jobs->command(\@cmd,
    environ => \%environ,
    buffer_size => $ENV{GITPREP_SMART_HTTP_BUFFER_SIZE},
    stdin => sub {
      my $chunk = $content->get_body_chunk($pos) // '';
      $pos += length $chunk;
      return $chunk;
    },
    stdout => sub {$outstream = $_[0]; $fifo->push($_[1]); ()},
    stderr => \$error,
    success => $terminate,
    failure => $terminate
  );

  # Start everything asynchronously.
  $jobs->run_jobs($job);
  return;
%>
