<%
  use Mojo::IOLoop;
  use Gitprep::Repository;
  use Gitprep::Jobs;

  my $service = param('service');
  my $user = param('user');
  my $project = param('project');

  my $git = app->git;
  my $jobs = app->jobs;

  my $auth_user_id = stash('auth_user_id') // '';

  my $rep_info = Gitprep::Repository->maybe_wiki($user, $project);

  my $outstream;        # Standard git output stream.
  my @chunks;           # Output chunks fifo.
  my $wcactive = 0;     # Flag currently writing chunk.
  my $error = '';       # Git error buffer.

  # Chunk output pump.
  my $wcpump;
  $wcpump = sub {
    my $c = shift;
    $wcactive = 0;
    if (@chunks) {
      my $chunk = shift @chunks;
      $outstream->start if $outstream;
      $wcactive = 1;
      $c->write_chunk($chunk, $wcpump);
    }
  };

  # Prepare response
  $self->res->headers->content_type("application/x-git-$service-result");
  $self->write_chunk;                   # Start chunked response.
  my $tx = $self->render_later->tx;     # Keep transaction alive.

  # Closeout function.
  my $terminate = sub {
    push @chunks, '';
    $self->$wcpump unless $wcactive;
    $self->app->log->error($self->url_for . ": $error") if $error ne '';
    $tx = undef;        # Release transaction.
    ()
  };

  # Command
  my @cmd = $git->cmd(
    $rep_info,
    $service,
    '--stateless-rpc',
    $rep_info->git_dir
  );

  # Preset hooks and get child environment.
  my %environ = %ENV;
  app->manager->prepare_hooks($rep_info, $auth_user_id, \%environ);

  # Prepare job.
  my $pos = 0;
  my $content = $self->req->content;
  my $job = $jobs->command(\@cmd,
    environ => \%environ,
    buffer_size => $ENV{GITPREP_SMART_HTTP_BUFFER_SIZE},
    stdin => sub {
      my $chunk = $content->get_body_chunk($pos) // '';
      $pos += length $chunk;
      return $chunk;
    },
    stdout => sub {
      ($outstream, my $chunk) = @_;
      push @chunks, $chunk;
      $outstream->stop if @chunks > 4;
      $self->$wcpump unless $wcactive;
      ()
    },
    stderr => \$error,
    success => $terminate,
    failure => $terminate
  );

  # Start everything asynchronously.
  $jobs->run_jobs($job);
%>
